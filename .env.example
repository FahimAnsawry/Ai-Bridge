# Runtime
NODE_ENV=development

# HOST: interface to bind the server on.
# Local default: 127.0.0.1. Deployment: use 0.0.0.0 or leave unset with NODE_ENV=production.
HOST=127.0.0.1

# PORT: single port for the API, auth routes, proxy routes, Socket.IO, and built dashboard.
# Hosted platforms usually provide this automatically.
PORT=3000

# Public app URL used for logs, OAuth redirects, and allowed CORS origins in production.
# Example: https://your-ai-bridge.onrender.com
FRONTEND_URL=http://localhost:5174
PUBLIC_URL=http://localhost:3000

# Comma-separated allowed browser origins. Leave unset for same-origin production deploys.
# CORS_ORIGINS=https://your-ai-bridge.onrender.com,http://localhost:5174

# Database
# Use MongoDB Atlas for deployment.
MONGODB_URI=mongodb://127.0.0.1:27017/ai-proxy

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Local dev with Vite: http://localhost:5174/auth/google/callback
# Production single-service deploy: https://your-ai-bridge.onrender.com/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:5174/auth/google/callback

# General settings
SESSION_SECRET=a-secure-random-string
ADMIN_EMAILS=admin@example.com

# Optional provider overrides
# LOCAL_API_KEY=your-secret-local-key
# ACTIVE_PROVIDER_ID=swiftrouter
# SWIFTROUTER_API_KEY=sk-xxxxxxx
# AGENTROUTER_API_KEY=sk-xxxxxxx
